{
  "name": "@fefeding/eventemitter",
  "version": "1.0.5",
  "description": "事件 emit",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node test/dev",
    "build": "gulp && node ./build/build.js",
    "test": "vitest",
    "update": "npx taze major  -w",
    "release": "npx bumpp --commit --tag --push",
    "api:json": "npx api-extractor run",
    "api:md": "npx api-documenter markdown -i ./docs/.api -o ./docs/api && node ./build/md.js",
    "api": "npm run api:json && npm run api:md",
    "push": "npm publish --registry=https://registry.npmjs.org",
    "docs:dev": "npm run api && vitepress dev",
    "docs:build": "npm run api && vitepress build",
    "docs:preview": "npm run api && vitepress preview"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-function-bind": "^7.27.1",
    "@babel/preset-env": "^7.28.5",
    "@babel/preset-stage-0": "^7.8.3",
    "@microsoft/api-documenter": "^7.28.1",
    "@microsoft/api-extractor": "^7.55.1",
    "@rollup/plugin-babel": "^6.1.0",
    "@rollup/plugin-commonjs": "^25.0.8",
    "@rollup/plugin-node-resolve": "^15.3.1",
    "babel-preset-es2015": "^6.24.1",
    "babel-preset-stage-0": "^6.24.1",
    "babelify": "^10.0.0",
    "browserify": "^17.0.1",
    "express": "^4.21.2",
    "gulp": "^4.0.2",
    "gulp-cli": "^2.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-typescript": "6.0.0-alpha.1",
    "rollup": "^4.53.3",
    "rollup-plugin-typescript2": "^0.36.0",
    "tsify": "^5.0.4",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vinyl-source-stream": "^2.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^1.6.1"
  },
  "dependencies": {
    "eventemitter3": "^5.0.1"
  },
  "author": "fefeding",
  "license": "MIT"
}
